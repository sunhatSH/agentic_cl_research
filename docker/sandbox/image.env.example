# Copy to image.env and fill after Tencent account + CCR namespace are ready.
# Used by scripts/build_sandbox_image.sh and scripts/push_sandbox_image.sh
#
# CCR personal edition example:
#   CCR_REGISTRY=ccr.ccs.tencentyun.com
#   CCR_NAMESPACE=my-namespace
#
# CCR enterprise edition example:
#   CCR_REGISTRY=your-instance.tencentcloudcr.com
#   CCR_NAMESPACE=my-namespace

CCR_REGISTRY=ccr.ccs.tencentyun.com
CCR_NAMESPACE=REPLACE_WITH_YOUR_NAMESPACE
IMAGE_NAME=agentic-cl-sandbox
IMAGE_TAG=v1

# Optional: override base sandbox-code image (default in Dockerfile ARG)
# SANDBOX_BASE_IMAGE=ccr.ccs.tencentyun.com/ags-image/sandbox-code:latest
