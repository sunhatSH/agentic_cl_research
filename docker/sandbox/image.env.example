# Copy to image.env and fill credentials (gitignored).
# Used by scripts/build_sandbox_image.sh and scripts/push_sandbox_image.sh
#
# 企业版 TCR（本项目用企业版）：
CCR_REGISTRY=tcr-rl.tencentcloudcr.com   # 企业版实例公网域名 = <实例名>.tencentcloudcr.com
CCR_NAMESPACE=agentos-cl-namespace        # 实例下命名空间
IMAGE_NAME=agentic-cl-sandbox
IMAGE_TAG=v1

# Optional: override base sandbox-code image (default in Dockerfile ARG)
# SANDBOX_BASE_IMAGE=tcr-rl.tencentcloudcr.com/agentos-cl-namespace/sandbox-code:latest
