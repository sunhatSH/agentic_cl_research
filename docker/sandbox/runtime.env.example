# 沙箱 Instance 内运行时环境变量（起实例时注入，不是本机 tencent.env）
# 用法:
#   cp docker/sandbox/runtime.env.example docker/sandbox/runtime.env
#   填非空值后: source scripts/load_tencent_env.sh  （会合并进 SANDBOX_RUNTIME_ENV）
#
# 与 configs/sandbox_runtime_env.json 同键；本文件优先（适合填密钥）。

# --- Python / 路径 ---
PYTHONUNBUFFERED=
PYTHONDONTWRITEBYTECODE=
TZ=
LANG=
AGENTIC_CL_WORKSPACE=
AGENTIC_CL_DATA_DIR=
AGENTIC_CL_CACHE_DIR=
AGENTIC_CL_LOG_LEVEL=

# --- agent harness (OpenClaw) + 随机用户文件系统 persona ---
# 推理在沙箱外：OPENCLAW_MODEL 指 vLLM endpoint 上 serve 的模型名；
# endpoint/key 复用下方 OPENAI_API_BASE / OPENAI_API_KEY。
# 冷启动沙箱内 hermes 用 AGENT_MODEL_* 三键（见 doc/模型选型.md）：
# 冷启动沙箱内 hermes 用 AGENT_MODEL_* 三键（见 doc/模型选型.md）：
#   AGENT_MODEL_NAME=gpt-5.5                   # off-policy 种子 actor（tokenhub gpt-5.5，非训练策略）
#   AGENT_MODEL_BASE=https://tokenhub.sensetime.com/v1
#   AGENT_MODEL_KEY=<tokenhub key>
# persona/seed 必须对同组 8 个槽注入相同值（见 doc/Sandbox_Agent架构.md §4）。
OPENCLAW_MODEL=
AGENTIC_CL_PERSONA=
AGENTIC_CL_FS_SEED=

# --- pip / 网络（任务要装包或走代理时）---
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# --- 任务工具 / 外部 API（ClawEval / Deep Research 类任务）---
WEB_SEARCH_API_URL=
WEB_SEARCH_API_KEY=
WEB_FETCH_PROXY=
WEB_FETCH_USER_AGENT=
TASK_MOCK_API_BASE_URL=
TASK_MOCK_API_KEY=

# --- 模型 endpoint（OpenClaw 在沙箱内调外部 vLLM；推理在沙箱外）---
# OPENAI_API_BASE 必填：指向集群上的 vLLM OpenAI 兼容 endpoint（需开 logprobs）。
# 本地 vLLM 无鉴权时 OPENAI_API_KEY 可填占位（如 sk-local）。
OPENAI_API_BASE=
OPENAI_API_KEY=
HF_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
