master-thesis/**/*.fdb_latexmk
master-thesis/**/*.fls
master-thesis/**/*.out
master-thesis/**/*.toc
master-thesis/**/*.lof
master-thesis/**/*.lot
master-thesis/**/*.bbl
master-thesis/**/*.bcf
master-thesis/**/*.blg
master-thesis/**/*.run.xml
master-thesis/**/*.idx
master-thesis/**/*.ilg
master-thesis/**/*.ind
master-thesis/**/*.synctex.gz
master-thesis/**/*.xdv
master-thesis/*xelatex*
*.pdf

# LaTeX build artifacts
paper/latex/main.aux
paper/latex/main.bbl
paper/latex/main.blg
paper/latex/main.out
paper/latex/main.log
paper/latex/main.pdf
/runs

# Reward-model selection sweep outputs (runtime logs/json; script is tracked)
rewardmodel_choose/results/
