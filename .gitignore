# IDE
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Compiled objects (unstripped tools)
*.o
*.so

# Node (sandbox docker may npm install at project root in docker build)
node_modules/

# Env / secrets
.env
.env.*
!.env.example
*.local

# Training artefacts
ckpts/
checkpoints/
outputs/
# runs/: 实验产物根目录 -- 内容忽略，但保留 README + 各目录 .gitkeep 作结构约定（见 runs/README.md）
runs/*
!runs/README.md
!runs/*/
runs/*/*
!runs/*/.gitkeep
logs/
*.log

# WandB / experiment trackers
wandb/
mlruns/

# Eval results + 运行时产物（含 .tmp 下 merge 的 HF 模型权重，单次可达数十 GB）
eval/results/
eval/.tmp/
eval/

# Buffer dumps (large, regenerated per run)
buffer_dumps/
*.lmdb
*.sqlite
*.sqlite-journal

# Datasets (raw sessions + generated queries; large, regenerated, not source)
datasets/

# Runtime collected data (mock rollouts + warm-start buffers; regenerated, not source)
/datasources/
rollouts/
# 例外:doc/expr/data/ 是实验档案(每step桶信息/metrics快照),属源码要入库,非运行时产物
!doc/expr/data/
# 例外:scripts/data/ 是数据管道源码(convert/label/parquet 等),非运行时产物
!scripts/data/

# Tencent / CCR local credentials (never commit)
docker/sandbox/tencent.env
docker/sandbox/image.env
docker/sandbox/runtime.env
.claude/

# macOS
.DS_Store

