{
  "_comment": "Agent Runtime custom sandbox TOOL. Image pushed to TCR enterprise (tcr-rl). See doc/Sandbox_腾讯云操作手册.md",
  "ToolName": "agentic-cl-sandbox",
  "ToolType": "custom",
  "Description": "Agentic CL GRPO rollout — sandbox-code base + OpenClaw + project deps (pandas/aiohttp/...)",
  "DefaultTimeout": "30m",
  "NetworkConfiguration": {
    "NetworkMode": "VPC",
    "VpcConfig": {
      "SubnetIds": ["subnet-ljfuh7ln"],
      "SecurityGroupIds": ["sg-irz5h5ed"]
    }
  },
  "RoleArn": "qcs::cam::uin/100048510516:roleName/AgentOS-260506-test",
  "CustomConfiguration": {
    "Image": "tcr-rl.tencentcloudcr.com/agentos-cl-namespace/agentic-cl-sandbox:v1",
    "ImageRegistryType": "enterprise",
    "Command": [
      "/init"
    ],
    "Ports": [
      {
        "Name": "envd",
        "Port": 49983,
        "Protocol": "TCP"
      }
    ],
    "Resources": {
      "CPU": "4",
      "Memory": "8Gi",
      "Storage": "20Gi"
    },
    "Probe": {
      "HttpGet": {
        "Path": "/health",
        "Port": 49983,
        "Scheme": "HTTP"
      },
      "ReadyTimeoutMs": 30000,
      "ProbeTimeoutMs": 2000,
      "ProbePeriodMs": 5000,
      "SuccessThreshold": 1,
      "FailureThreshold": 36
    }
  }
}
