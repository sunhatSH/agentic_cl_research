# Local training secrets template — copy to .env and fill real keys.
#
#   cp .env.example .env   # then edit .env
#   source scripts/load_training_env.sh
#
# .env is gitignored; NEVER commit real keys. This template is the canonical
# shape of .env so the convention is version-controlled.
#
# ── 单一信源约定（见 doc/模型选型.md）───────────────────────────────────
# 本文件【只放凭证 / 密钥】。模型选型（api_base / model / temperature /
# questioner rotation）的单一信源是 configs/agents.yaml，代码经
# agents/config.py 的 resolve_observer / resolve_questioner / resolve_judge 读取。
# OBSERVER_* / USERSIM_* / REWARD_* 环境变量仅作 override / fallback，本文件
# 不设，以免选型在两处重复、漂移。
#
# 训练 / 采集脚本（run_phases.sh / collect_rollout.sh / _node_worker.sh）会按需
# 自己 export 端点 override（如 mock-judge smoke、远程采集场景），与本文件无关。

# SwanLab 实验追踪 key (https://swanlab.cn)。
SWANLAB_API_KEY=

# tokenhub API key — observer / questioner / reward 三 agent 共用（endpoint
# tokenhub.sensetime.com/v1，沙箱可直连）。agents.yaml 里各角色的 key_env 都指向本变量；
# endpoint 与模型名由 yaml 决定。沙箱内 off-policy 种子 actor (hermes) 用 runtime.env 的
# AGENT_MODEL_KEY（可填同一个 tokenhub key）。
TOKENHUB_API_KEY=
